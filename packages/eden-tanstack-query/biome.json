{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": false,
	"extends": "//",
	"linter": {
		"rules": {
			"suspicious": {
				"noConfusingVoidType": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/context.tsx",
				"test/react/context.test.tsx",
				"test/integration/useQuery.test.tsx",
				"test/integration/useMutation.test.tsx",
				"test/integration/useInfiniteQuery.test.tsx"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	]
}
